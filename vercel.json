{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/apresentacao",
      "destination": "/apresentacao/index.html"
    },
    {
      "source": "/apresentacao/",
      "destination": "/apresentacao/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
